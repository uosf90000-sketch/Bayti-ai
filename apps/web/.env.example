# كل قيمة أدناه mock افتراضيًا (لا حاجة لأي إعداد للتشغيل المحلي).
# اقلب أي flag إلى false فقط بعد ربط الخدمة الحقيقية المقابلة — راجع docs/SESSION_HANDOFF.md.

NEXT_PUBLIC_USE_MOCK_AUTH=true
NEXT_PUBLIC_USE_MOCK_ANALYSIS=true
NEXT_PUBLIC_USE_MOCK_COUNCIL=true
NEXT_PUBLIC_USE_MOCK_RESULTS=true

# VS-4 — سجل المشاريع + Storage المخططات + checkpoints التحليل (راجع supabase/README.md)
NEXT_PUBLIC_USE_MOCK_PROJECTS=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=floorplans

# الرمز التجريبي 1234 — development فقط. فعّله في بيئة Preview فقط (ليس production):
# NEXT_PUBLIC_ALLOW_TEST_OTP=true
